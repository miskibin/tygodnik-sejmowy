# Supabase project credentials
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM: DeepSeek only.
DEEPSEEK_API_KEY=
# Prints (text + scanned pages) — flash pricing, vision capable.
SUPAGRAF_LLM_MODEL_VISION=deepseek-flash
# Statements / voting titles / act titles.
SUPAGRAF_LLM_MODEL_FLASH=deepseek-flash
SUPAGRAF_LLM_MODEL_PRO=deepseek-v4-pro
# SUPAGRAF_LLM_ROUTING=pro_flash   # legacy substantive→pro / procedural→flash router
# SUPAGRAF_LLM_MODEL=              # pin ONE model for every job (beats routing)
SUPAGRAF_LLM_TIMEOUT_S=300
# SUPAGRAF_LLM_THINKING=off        # off | low | high | max (global default)
# SUPAGRAF_PRINT_THINKING=off      # unified print call; "low" ≈ 3x cost per print
# SUPAGRAF_PRINT_MAX_INPUT_CHARS=240000
# SUPAGRAF_VISION_OCR=1            # 0 → Tesseract only for scans
# SUPAGRAF_ENRICH_WORKERS=4        # concurrent LLM calls in the daily

# Updater (python -m supagraf daily) — see docs/updater.md
# SUPAGRAF_LOAD_DIRECT_DSN=postgresql://postgres:<pwd>@supabase-db:5432/postgres  # mixvm: bypass Kong 60 s timeout
# SUPAGRAF_EMBED_LIMIT=0
# SUPAGRAF_DAILY_SKIP_EMBED=0

# Embeddings (Ollama)
# OLLAMA_BASE_URL=http://localhost:11434

mobile/node_modules/
mobile/.expo/
mobile/android/
mobile/ios/
mobile/dist/
mobile/.env
mobile/expo-env.d.ts

# Stray root node_modules (frontend/ has its own — none expected at repo root)
/node_modules/

# Debug / one-off screenshot dumps from quote-share + verdict overflow checks.
